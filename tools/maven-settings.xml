<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven settings для сборки в изолированной среде:
  - локальный репозиторий внутри workspace (домашний каталог может быть недоступен на запись);
  - Maven Central вместо корпоративных зеркал, недоступных из этой сети.
  Использование: mvn -s tools/maven-settings.xml ...
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
    <localRepository>D:/BORISOV/ai/deepseek2/.m2repo</localRepository>
    <mirrors>
        <mirror>
            <id>central-direct</id>
            <mirrorOf>*</mirrorOf>
            <url>https://repo.maven.apache.org/maven2</url>
        </mirror>
    </mirrors>
</settings>
